# Catalyst — konfigurasi. Salin ke .env.local lalu isi nilainya.
#
#     cp .env.example .env.local
#
# .env.local git-ignored. Jangan pernah commit kunci, jangan pernah tempel ke
# issue, screenshot, atau chat. Kunci yang ter-commit adalah diskualifikasi
# paling klasik di hackathon ini.
#
# Tidak satu pun variabel kunci di bawah berawalan NEXT_PUBLIC_ — itu
# disengaja. Awalan itu membuat nilainya ikut ter-bundle ke browser. Semua
# kunci hanya boleh dibaca di route handler / server component. Satu-satunya
# pengecualian adalah NEXT_PUBLIC_API_BASE_URL (URL, bukan rahasia) pada
# bagian Split deploy di bawah.

# --- LLM: Gemini ------------------------------------------------------------
# Jalur yang dipakai: Gemini Developer API, free tier.
# Kunci dari https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Jalur cadangan — Vertex AI, tanpa kunci, auth lewat Application Default
# Credentials. Belum dipakai. Kalau kuota free tier tidak cukup, isi tiga
# variabel ini dan kosongkan GOOGLE_API_KEY; kode pemanggil tidak berubah.
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=ada-sectors-508410
# GOOGLE_CLOUD_LOCATION=us-central1

# Model yang dipakai lapisan agent. Konfirmasi ID persisnya dulu — daftar model
# berubah lebih cepat daripada dokumen mana pun. Cara mengecek:
#   await ai.models.list()          (SDK)
#   https://aistudio.google.com/    (daftar model pada akun kamu)
GEMINI_MODEL=gemini-3.5-flash

# deterministic = mesin aturan saja, tanpa panggilan model (dipakai oleh test).
# llm          = lapisan agent aktif.
AGENT_MODE=deterministic

# Plafon panggilan model per hari. Di free tier batasnya kuota, bukan uang, jadi
# setel angka ini di bawah RPD model yang dipilih. Lewat plafon atau kena 429,
# aplikasi turun ke jalur deterministic dan memberi tahu pengguna lewat catatan
# di jawaban. Hitungannya disimpan per hari di
# gs://$GCS_CACHE_BUCKET/catalyst/_ledger/llm/<tanggal>.json.
# Kalau ledger tidak terbaca, hitungan jatuh ke memori proses: satu instance
# tetap membatasi diri, beberapa instance bisa melampaui plafon sampai GCS
# menjawab lagi. Dikosongkan berarti tanpa plafon — volume panggilan tidak
# dibatasi sama sekali.
LLM_DAILY_CALL_BUDGET=200

# --- Sectors API ------------------------------------------------------------
# Hanya dibutuhkan kalau refresh cache dijalankan dari repo ini. Selama data
# masih dibaca dari data/sectors/, biarkan kosong.
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app

# Plafon credit Sectors per hari. Grant 1.000, tidak bisa diisi ulang.
SECTORS_DAILY_BUDGET=25

# Refresh Sectors terjadwal — default MATI. Tiga keadaan:
#   unset (disarankan) = sakelar "Refresh data Sectors" di Pengaturan yang
#                        mengatur (flag runtime di GCS, default mati);
#   true               = paksa AKTIF, sakelar UI lapor 409 (tak berlaku);
#   false              = paksa MATI (kill-switch operator, menang atas UI).
# Recorded bundle tetap melayani sampai refresh diizinkan.
# SECTORS_REFRESH_ENABLED=

# Bearer guard untuk rute internal (/api/internal/*). Wajib diisi saat deploy:
# kalau kosong saat NODE_ENV=production (atau di Cloud Run via K_SERVICE),
# rute internal gagal-tertutup 503 (lihat lib/internal-auth.ts); saat kosong
# di dev lokal saja rute berjalan terbuka.
# INTERNAL_CRON_SECRET=

# Token operator untuk mutasi dari UI: menyetujui/menolak kandidat pantauan
# (POST /api/web-watch) dan sakelar refresh Sectors (POST /api/settings/refresh).
# Di produksi wajib diisi — kalau kosong kedua rute menjawab 503, bukan terbuka.
# Lokal boleh kosong. Operator menempelkannya sekali di Pengaturan -> Token operator.
# OPERATOR_TOKEN=

# --- Penyimpanan (dipakai saat deploy, bukan saat lokal) --------------------
# GCS_MEMORY_BUCKET=catalyst-memory
# GCS_CACHE_BUCKET=catalyst-recorded

# --- Split deploy: Vercel UI + Cloud Run API (UI Cloud Run tetap jalan) -----
# Vercel UI:  NEXT_PUBLIC_API_BASE_URL=https://<cloud-run-service>.run.app
#             (semua fetch /api/* dari browser mengarah ke Cloud Run).
# Cloud Run UI / lokal: kosongkan — panggilan tetap same-origin relatif
#             (/api/...) dan versi UI Cloud Run tidak berubah.
# NEXT_PUBLIC_API_BASE_URL=
#
# Cloud Run: daftar origin Vercel yang boleh memanggil /api/*, koma-pisah.
# Kosong = same-origin saja. Contoh:
# API_CORS_ORIGIN=https://catalyst.vercel.app
# API_CORS_ORIGIN=
