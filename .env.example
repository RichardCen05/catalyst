# Catalyst — konfigurasi. Salin ke .env.local lalu isi nilainya.
#
#     cp .env.example .env.local
#
# .env.local git-ignored. Jangan pernah commit kunci, jangan pernah tempel ke
# issue, screenshot, atau chat. Kunci yang ter-commit adalah diskualifikasi
# paling klasik di hackathon ini.
#
# Tidak satu pun variabel di bawah berawalan NEXT_PUBLIC_ — itu disengaja.
# Awalan itu membuat nilainya ikut ter-bundle ke browser. Semua kunci di sini
# hanya boleh dibaca di route handler / server component.

# --- LLM: Gemini ------------------------------------------------------------
# Jalur yang dipakai: Gemini Developer API, free tier.
# Kunci dari https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Jalur cadangan — Vertex AI, tanpa kunci, auth lewat Application Default
# Credentials. Belum dipakai. Kalau kuota free tier tidak cukup, isi tiga
# variabel ini dan kosongkan GOOGLE_API_KEY; kode pemanggil tidak berubah.
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=ada-sectors-508410
# GOOGLE_CLOUD_LOCATION=us-central1

# Model yang dipakai lapisan agent. Konfirmasi ID persisnya dulu — daftar model
# berubah lebih cepat daripada dokumen mana pun. Cara mengecek:
#   await ai.models.list()          (SDK)
#   https://aistudio.google.com/    (daftar model pada akun kamu)
GEMINI_MODEL=gemini-3.5-flash

# deterministic = mesin aturan saja, tanpa panggilan model (dipakai oleh test).
# llm          = lapisan agent aktif.
AGENT_MODE=deterministic

# Plafon panggilan model per hari. Di free tier batasnya kuota, bukan uang, jadi
# setel angka ini di bawah RPD model yang dipilih. Lewat plafon atau kena 429,
# aplikasi turun ke jalur deterministic dan memberi tahu pengguna.
LLM_DAILY_CALL_BUDGET=200

# --- Sectors API ------------------------------------------------------------
# Hanya dibutuhkan kalau refresh cache dijalankan dari repo ini. Selama data
# masih dibaca dari data/sectors/, biarkan kosong.
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app

# Plafon credit Sectors per hari. Grant 1.000, tidak bisa diisi ulang.
SECTORS_DAILY_BUDGET=25

# --- Penyimpanan (dipakai saat deploy, bukan saat lokal) --------------------
# GCS_MEMORY_BUCKET=catalyst-memory
# GCS_CACHE_BUCKET=catalyst-recorded
