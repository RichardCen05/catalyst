ertex="1" parent="e5"><mxGeometry x="0" y="0" width="22" height="22" relative="1" as="geometry"><mxPoint x="-11" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="threats" value="Threats · STRIDE" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#DDDDDD;shadow=0;align=left;verticalAlign=top;spacing=10;spacingTop=-4;fontSize=13;fontStyle=1;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="80" y="468" width="1314" height="176" as="geometry"/></mxCell><mxCell id="threat0" value="1. &lt;b&gt;Spoofing&lt;/b&gt; · jagoanku misal BBCA — Misal di warnet ada yang ngaku jadi kamu liat BBCA-mu &lt;font style=&quot;color:#188038&quot;&gt;→ Pakai browser sendiri, habis pakai warnet keluar + hapus&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3C4043;spacingLeft=2;whiteSpace=wrap;" vertex="1" parent="threats"><mxGeometry x="12" y="34" width="1290" height="22" as="geometry"/></mxCell><mxCell id="threat1" value="2. &lt;b&gt;Information disclosure&lt;/b&gt; · jagoanku misal BBCA — Misal screenshare, list BBCA-mu keliatan orang &lt;font style=&quot;color:#188038&quot;&gt;→ Tutup dulu pas share, jangan pasang nama di gambar&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3C4043;spacingLeft=2;whiteSpace=wrap;" vertex="1" parent="threats"><mxGeometry x="12" y="56" width="1290" height="22" as="geometry"/></mxCell><mxCell id="threat2" value="3. &lt;b&gt;Tampering&lt;/b&gt; · minta harga BBCA — Misal angka 11 Sep dikira hari ini jalan &lt;font style=&quot;color:#188038&quot;&gt;→ Tiap layar tulis tanggalnya, misal 11 Sep di samping harga&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3C4043;spacingLeft=2;whiteSpace=wrap;" vertex="1" parent="threats"><mxGeometry x="12" y="78" width="1290" height="22" as="geometry"/></mxCell><mxCell id="threat3" value="4. &lt;b&gt;Information disclosure&lt;/b&gt; · baca coretanku — Misal coretan BBCA kuat dibaca temen &lt;font style=&quot;color:#188038&quot;&gt;→ Coretan cuma di browsermu, ga dikirim keluar&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3C4043;spacingLeft=2;whiteSpace=wrap;" vertex="1" parent="threats"><mxGeometry x="12" y="100" width="1290" height="22" as="geometry"/></mxCell><mxCell id="threat4" value="5. &lt;b&gt;Denial of service&lt;/b&gt; · baca buku buat jawab — Misal penolong malah bilang beli aja! &lt;font style=&quot;color:#188038&quot;&gt;→ Dilarang bilang beli-jual, wajib kasih sumber&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3C4043;spacingLeft=2;whiteSpace=wrap;" vertex="1" parent="threats"><mxGeometry x="12" y="122" width="1290" height="22" as="geometry"/></mxCell><mxCell id="threat5" value="6. &lt;b&gt;Elevation of privilege&lt;/b&gt; · teruskan tanya — Misal coretan dipakai ubah harga BBCA &lt;font style=&quot;color:#188038&quot;&gt;→ Coretan ga bisa ubah angka, cuma bisa ubah urutan&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3C4043;spacingLeft=2;whiteSpace=wrap;" vertex="1" parent="threats"><mxGeometry x="12" y="144" width="1290" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>